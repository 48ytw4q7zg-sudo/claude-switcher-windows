<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!--
  Application manifest (C-6).
  - Keep the Common-Controls 6.0 dependency (required by Tauri dialog APIs).
  - asInvoker: never request elevation (the tool only touches current-user data).
  - supportedOS: Windows 10/11 GUID (avoids wrong compatibility-layer decisions).
  - longPathAware: long paths take effect once the system LongPathsEnabled is on;
    with it off, behaviour is unchanged (no side effects).

  This file MUST stay pure ASCII. rc.exe decodes a UTF-8 source but re-encodes an
  RT_MANIFEST blob to the system ANSI code page when no /c 65001 flag is passed
  (tauri-winres/embed-resource pass none). Any non-ASCII byte here would be stored
  in that ANSI code page while the header still declares UTF-8, which makes the
  activation context fail with "invalid XML syntax" and the exe won't start.
  See AGENTS.md pitfall #27.
-->
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <assemblyIdentity version="{{VERSION}}" name="io.github.48ytw4q7zg-sudo.claude-switcher" type="win32"/>
  <dependency>
    <dependentAssembly>
      <assemblyIdentity
        type="win32"
        name="Microsoft.Windows.Common-Controls"
        version="6.0.0.0"
        processorArchitecture="*"
        publicKeyToken="6595b64144ccf1df"
        language="*"/>
    </dependentAssembly>
  </dependency>
  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v3">
    <security>
      <requestedPrivileges>
        <requestedExecutionLevel level="asInvoker" uiAccess="false"/>
      </requestedPrivileges>
    </security>
  </trustInfo>
  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Windows 10 / 11 -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}"/>
    </application>
  </compatibility>
  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <longPathAware xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">true</longPathAware>
    </windowsSettings>
  </application>
</assembly>
