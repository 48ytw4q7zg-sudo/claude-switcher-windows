{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ClaudeSwitcher",
  "version": "0.5.0",
  "identifier": "io.github.48ytw4q7zg-sudo.claude-switcher",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "trayIcon": {
      "id": "main",
      "iconPath": "icons/tray.png",
      "iconAsTemplate": true,
      "showMenuOnLeftClick": false,
      "title": "",
      "tooltip": "Claude Switcher"
    },
    "security": {
      "csp": null
    },
    "windows": [
      {
        "label": "main",
        "title": "Claude Switcher",
        "width": 1120,
        "height": 760,
        "minWidth": 980,
        "minHeight": 680,
        "visible": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "publisher": "48ytw4q7zg-sudo",
    "copyright": "Copyright (c) 2026 48ytw4q7zg-sudo",
    "targets": "all",
    "externalBin": ["binaries/cs"],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "wix": {
        "language": "zh-CN"
      },
      "nsis": {
        "languages": [
          "SimpChinese"
        ],
        "displayLanguageSelector": false
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "opener": {}
  }
}
